{
  "name": "The Black Parade — MCR Lyrics",
  "short_name": "MCR Lyrics",
  "description": "Offline lyric book and setlist builder for My Chemical Romance. Built for venues with no signal.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#08080b",
  "theme_color": "#08080b",
  "categories": [
    "music",
    "entertainment",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Setlist",
      "short_name": "Setlist",
      "url": "./index.html#/setlist"
    },
    {
      "name": "All Songs",
      "short_name": "Songs",
      "url": "./index.html#/songs"
    },
    {
      "name": "Search",
      "short_name": "Search",
      "url": "./index.html#/"
    }
  ]
}
